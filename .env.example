# The only variable you need. Generate at:
# https://www.discogs.com/settings/developers
DISCOGS_TOKEN=

# Optional. Discogs requires a User-Agent; a sensible default is used if unset.
# DISCOGS_USER_AGENT=MyMusicApp/1.0 +https://example.com

# Optional. If unset, the username is auto-resolved from /oauth/identity
# on the first call that needs it.
# DISCOGS_DEFAULT_USERNAME=
